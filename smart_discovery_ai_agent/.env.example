# Copy to .env and edit. Never commit .env. Everything below is optional: the app starts with none of it.

# --- Web app (discovery/) ------------------------------------------------------
# Database. Default: SQLite file discovery.db in the project folder.
# DATABASE_URL=sqlite:///discovery.db

# LLM for the tool-using agent (Anthropic). Without a key the app uses the rule-based fallback.
# Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# FREE alternative: any OpenAI-compatible endpoint with function calling (set LLM_MODEL too).
# Examples (check each provider's docs for current free-tier limits and model names):
#   Google Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  (key: https://aistudio.google.com/apikey)
#   Groq          : LLM_BASE_URL=https://api.groq.com/openai/v1                           (key: https://console.groq.com/keys)
#   Ollama (local): LLM_BASE_URL=http://localhost:11434/v1   (no key; run `ollama pull <tool-capable model>`)
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_BASE_URL=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=45

# OpenStreetMap services require an identifying contact in the User-Agent (an email or URL).
OSM_CONTACT=
# Comma-separated Overpass endpoints tried in order (defaults to three public mirrors).
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Set to true when served over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false
# Allow users to opt in to the clearly labelled fictional demo restaurants.
ALLOW_DEMO_DATA=true

# --- Legacy Streamlit/CLI prototype (app.py, main.py) ----------------------------
# LLM_PROVIDER=none          # none | openai | anthropic
# LLM_API_KEY=
# LLM_BASE_URL=              # optional OpenAI-compatible endpoint
